# Blumen Event Planner — copy to .env.local and Netlify env vars
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Official Blumen email (Resend — verify blumentechnologies.com first)
RESEND_API_KEY=
SMTP_FROM=Blumen Technologies <office@blumentechnologies.com>

# Optional Gmail/Brevo instead of Resend
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=587

# Official Blumen WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional approved template instead of a session text
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Or Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
